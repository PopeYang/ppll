---
import { getCollection, type CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import DocPage from '../../layouts/DocPage.astro';
import { getDocPath, slugFromPath } from '../../lib/routes';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry: CollectionEntry<'docs'>) => {
    const absolutePath = getDocPath(entry);
    return {
      params: { slug: slugFromPath(absolutePath, '/docs/') },
      props: { entry },
    };
  });
}

interface Props {
  entry: CollectionEntry<'docs'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<DocPage entry={entry}>
  <Content />
</DocPage>
