---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('docs');
const posts = entries
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const tags = [...new Set(posts.flatMap(p => p.data.tags || []))];
---

<Base title="凭岚文库" description="技术探索的笔记与踩坑实录">
  <div class="docs-layout">
    <main class="docs-main">
      <header class="page-header">
        <h1>凭岚文库</h1>
      </header>

      <div class="article-list">
        {posts.map((post) => (
          <article class="article-item">
            <a href={`/docs/${post.slug}/`} class="article-link">
              <h3 class="article-title">{post.data.title}</h3>
              {post.data.description && (
                <p class="article-excerpt">{post.data.description}</p>
              )}
              <time class="article-date">
                {new Date(post.data.date).toLocaleDateString('zh-CN')}
              </time>
            </a>
          </article>
        ))}
      </div>
    </main>

    <aside class="docs-sidebar" aria-label="标签">
      <div class="sidebar-block">
        <h3 class="sidebar-title">标签</h3>
        <nav class="tag-list">
          {tags.map((tag) => (
            <a href={`/docs/tag/${encodeURIComponent(tag)}/`} class="sidebar-tag">
              {tag}
            </a>
          ))}
        </nav>
      </div>
    </aside>
  </div>
</Base>

<style>
  .docs-layout {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1.5rem 5rem;
    display: grid;
    grid-template-columns: 7fr 3fr;
    gap: 4rem;
  }

  .docs-main {
    min-width: 0;
  }

  .page-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .page-header h1 {
    font-size: 1.8rem;
    font-weight: 300;
    letter-spacing: 0.1em;
    margin: 0;
    color: var(--color-heading);
  }

  /* 纯文本文章列表 */
  .article-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 2.5rem;
  }

  .article-item {
    padding-bottom: 0.5rem;
  }

  .article-link {
    color: inherit;
    text-decoration: none;
  }

  .article-link:hover .article-title {
    color: var(--color-primary-dark);
  }

  .article-title {
    font-size: 1.05rem;
    font-weight: 500;
    margin: 0 0 0.4rem;
    line-height: 1.45;
    color: var(--color-heading);
    transition: color 0.15s ease;
  }

  .article-excerpt {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-muted);
    margin: 0 0 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-date {
    font-size: 0.75rem;
    color: var(--color-muted);
    opacity: 0.7;
  }

  /* 侧边栏 */
  .docs-sidebar {
    padding-top: 5.2rem;
  }

  .sidebar-block {
    padding: 1.5rem;
  }

  .sidebar-title {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    text-transform: uppercase;
    margin: 0 0 1rem;
  }

  .tag-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .sidebar-tag {
    display: block;
    padding: 0.4rem 0;
    color: var(--color-text);
    font-size: 0.85rem;
    transition: color 0.15s ease;
    text-decoration: none;
  }

  .sidebar-tag:hover {
    color: var(--color-primary-dark);
  }

  :root[data-theme='dark'] .sidebar-tag:hover {
    color: var(--color-primary);
  }

  /* 响应式 */
  @media (max-width: 900px) {
    .docs-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-top: 3rem;
    }

    .article-list {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .docs-sidebar {
      padding-top: 1rem;
      border-top: 1px solid var(--color-border);
    }

    .sidebar-block {
      padding: 1.5rem 0;
    }

    .tag-list {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
    }
  }
</style>
