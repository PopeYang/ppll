---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { toDocList, collectTags, tagToSlug } from '../../lib/tags';

const entries = await getCollection('docs');
const posts = toDocList(entries);
const tags = collectTags(entries);

function fmtDate(d: Date): string {
  return d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Base title="凭岚文库" description="技术探索的笔记与踩坑实录">
  <header class="page-header">
    <h1>凭岚文库</h1>
    <p class="subtitle">技术探索的笔记与踩坑实录，共 {posts.length} 篇。</p>
  </header>

  <div class="docs-layout">
    <main class="docs-main">
      <div class="card-grid">
        {posts.map((post) => (
          <a href={post.url} class="card">
            <div class="card-cover">
              {post.cover ? (
                <Image src={post.cover} alt={post.title} width={480} height={270} />
              ) : (
                <div class="card-cover-fallback">
                  <span class="cover-emoji">{post.emoji ?? '📄'}</span>
                </div>
              )}
            </div>
            <div class="card-body">
              <h2 class="card-title">{post.title}</h2>
              {post.description && <p class="card-desc">{post.description}</p>}
              <div class="card-meta">
                <time datetime={post.date.toISOString()}>{fmtDate(post.date)}</time>
              </div>
            </div>
          </a>
        ))}
      </div>
    </main>

    <aside class="docs-sidebar" aria-label="标签">
      <div class="sidebar-block">
        <h3 class="sidebar-title">标签</h3>
        <nav class="tag-list">
          {tags.map(({ tag, count }) => (
            <a href={`/docs/tag/${tagToSlug(tag)}/`} class="sidebar-tag">
              <span>#{tag}</span>
              <span class="sidebar-tag-count">{count}</span>
            </a>
          ))}
        </nav>
      </div>
    </aside>
  </div>
</Base>

<style>
  .page-header {
    margin-bottom: 2rem;
  }

  .page-header h1 {
    margin-bottom: 0.3rem;
  }

  .subtitle {
    color: var(--color-muted);
    margin: 0;
  }

  /* 双栏：卡片网格 + 右侧 tag 边栏 */
  .docs-layout {
    display: grid;
    grid-template-columns: 1fr 220px;
    gap: 2.5rem;
    align-items: start;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.2rem;
  }

  /* Vapor 风格卡片 — 超大圆角、柔和阴影、无边框 */
  .card {
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    background: var(--color-surface);
    overflow: hidden;
    box-shadow:
      0 2px 8px rgba(0, 0, 0, 0.03),
      0 0 0 1px rgba(0, 0, 0, 0.02);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .card:hover {
    text-decoration: none;
    transform: translateY(-3px);
    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.08),
      0 0 0 1px rgba(0, 0, 0, 0.03);
  }

  /* 封面区：固定 16:9 比例 */
  .card-cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-surface-muted);
  }

  .card-cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0;
    border: none;
    box-shadow: none;
    margin: 0;
  }

  /* 无封面时的渐变占位 */
  .card-cover-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(
      155deg,
      rgba(193, 95, 60, 0.12) 0%,
      rgba(193, 95, 60, 0.02) 100%
    );
    border-radius: 20px 20px 0 0;
  }

  :root[data-theme='dark'] .card-cover-fallback {
    background: linear-gradient(
      155deg,
      rgba(232, 150, 118, 0.1) 0%,
      rgba(232, 150, 118, 0.02) 100%
    );
  }

  .cover-emoji {
    font-size: 2.4rem;
    line-height: 1;
    opacity: 0.85;
  }

  .card-body {
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-heading);
    margin: 0 0 0.5rem;
    line-height: 1.4;
  }

  .card-desc {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin: 0 0 0.75rem;
    line-height: 1.5;
    /* 限制两行 */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .card-meta {
    color: var(--color-muted);
    font-size: 0.8rem;
  }

  /* 右侧 tag 边栏 */
  .docs-sidebar {
    position: sticky;
    top: 80px;
  }

  .sidebar-block {
    padding: 1.5rem;
    border-radius: 20px;
    background: var(--color-surface);
    box-shadow:
      0 2px 8px rgba(0, 0, 0, 0.03),
      0 0 0 1px rgba(0, 0, 0, 0.02);
  }

  .sidebar-title {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 1rem;
  }

  .tag-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .sidebar-tag {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.75rem;
    border-radius: 12px;
    color: var(--color-text);
    font-size: 0.9rem;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .sidebar-tag:hover {
    background: rgba(193, 95, 60, 0.08);
    color: var(--color-primary-darker);
    text-decoration: none;
  }

  :root[data-theme='dark'] .sidebar-tag:hover {
    background: rgba(232, 150, 118, 0.08);
    color: var(--color-primary);
  }

  .sidebar-tag-count {
    color: var(--color-muted);
    font-size: 0.78rem;
    background: var(--color-bg);
    padding: 0.1rem 0.5rem;
    border-radius: 9999px;
    min-width: 24px;
    text-align: center;
  }

  /* 响应式：窄屏时边栏移到顶部 */
  @media (max-width: 900px) {
    .docs-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .docs-sidebar {
      position: static;
      order: -1;
    }
  }
</style>
