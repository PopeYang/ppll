---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { toDocList, collectTags, tagToSlug } from '../../../lib/tags';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  const tags = collectTags(entries);
  return tags.map(({ tag, count }) => ({
    params: { tag: tagToSlug(tag) },
    props: { tag, count },
  }));
}

interface Props {
  tag: string;
  count: number;
}

const { tag, count } = Astro.props;
const entries = await getCollection('docs');
const all = toDocList(entries).filter((p) => p.tags.includes(tag));

function fmtDate(d: Date): string {
  return d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Base title={`#${tag}`} description={`标记为 ${tag} 的文档`}>
  <header class="page-header">
    <div class="breadcrumb">
      <a href="/docs/">文档</a> <span class="sep">/</span> <span>#{tag}</span>
    </div>
    <h1>#{tag}</h1>
    <p class="subtitle">共 {count} 篇</p>
  </header>

  <div class="card-grid">
    {all.map((post) => (
      <a href={post.url} class="card">
        <div class="card-cover">
          {post.cover ? (
            <Image src={post.cover} alt={post.title} width={480} height={270} />
          ) : (
            <div class="card-cover-fallback">
              <span class="cover-emoji">{post.emoji ?? '📄'}</span>
            </div>
          )}
        </div>
        <div class="card-body">
          <h2 class="card-title">{post.title}</h2>
          {post.description && <p class="card-desc">{post.description}</p>}
          <div class="card-meta">
            <time datetime={post.date.toISOString()}>{fmtDate(post.date)}</time>
          </div>
        </div>
      </a>
    ))}
  </div>
</Base>

<style>
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-bottom: 0.5rem;
  }

  .breadcrumb a {
    color: var(--color-muted);
  }

  .breadcrumb .sep {
    margin: 0 0.4rem;
    opacity: 0.6;
  }

  .page-header {
    margin-bottom: 2rem;
  }

  .page-header h1 {
    margin-bottom: 0.3rem;
  }

  .subtitle {
    color: var(--color-muted);
    margin: 0;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.2rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    overflow: hidden;
    transition: transform 0.14s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .card:hover {
    text-decoration: none;
    transform: translateY(-3px);
    border-color: var(--color-primary);
    box-shadow: 0 6px 20px rgba(217, 119, 87, 0.12);
  }

  .card-cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-surface-muted);
  }

  .card-cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0;
    border: none;
    box-shadow: none;
    margin: 0;
  }

  .card-cover-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(
      135deg,
      rgba(217, 119, 87, 0.18) 0%,
      rgba(217, 119, 87, 0.06) 100%
    );
  }

  :root[data-theme='dark'] .card-cover-fallback {
    background: linear-gradient(
      135deg,
      rgba(239, 165, 129, 0.16) 0%,
      rgba(239, 165, 129, 0.04) 100%
    );
  }

  .cover-emoji {
    font-size: 2.4rem;
    line-height: 1;
    opacity: 0.85;
  }

  .card-body {
    padding: 1rem 1.1rem 1.1rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-heading);
    margin: 0 0 0.4rem;
    line-height: 1.4;
  }

  .card-desc {
    color: var(--color-muted);
    font-size: 0.88rem;
    margin: 0 0 0.7rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .card-meta {
    color: var(--color-muted);
    font-size: 0.8rem;
  }
</style>
