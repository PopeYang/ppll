---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base>
  <section class="hero">
    <h1 class="hero-title">{site.title}</h1>
    <p class="hero-subtitle">{site.tagline}</p>
    <div class="hero-buttons">
      <a class="btn btn-primary" href="/docs">📘 破破文档</a>
      <a class="btn btn-secondary" href="/now">💬 动态</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    text-align: center;
    padding: 4rem 1rem 3rem;
    background: var(--color-surface);
    border-radius: var(--radius);
    margin-top: 2rem;
    border: 1px solid var(--color-border);
  }

  :root[data-theme='dark'] .hero {
    background: var(--color-surface);
  }

  .hero-title {
    font-size: 3rem;
    margin-bottom: 0.5rem;
    letter-spacing: -0.03em;
  }

  .hero-subtitle {
    /* 手写体 — 移植自 Docusaurus 的 Brush Script MT 栈 */
    font-family: 'Brush Script MT', 'Segoe Script', 'Lucida Handwriting',
      'Apple Chancery', cursive;
    font-size: 2rem;
    color: var(--color-text);
    opacity: 0.9;
    margin-bottom: 2.5rem;
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
    font-weight: 500;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.15s ease;
    text-decoration: none;
    border: 1px solid transparent;
  }

  .btn:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }

  .btn-primary {
    background: var(--color-primary);
    color: white;
    box-shadow: 0 2px 8px rgba(193, 95, 60, 0.25);
  }

  .btn-primary:hover {
    background: var(--color-primary-dark);
    box-shadow: 0 2px 8px rgba(193, 95, 60, 0.35);
  }

  .btn-secondary {
    background: var(--color-surface-muted);
    color: var(--color-text);
    border-color: var(--color-border);
  }

  .btn-secondary:hover {
    background: var(--color-border);
  }

  :root[data-theme='dark'] .btn-primary {
    box-shadow: 0 2px 8px rgba(232, 150, 118, 0.2);
  }

  :root[data-theme='dark'] .btn-primary:hover {
    box-shadow: 0 2px 8px rgba(232, 150, 118, 0.3);
  }

  :root[data-theme='dark'] .btn-secondary {
    background: var(--color-surface-muted);
  }

  :root[data-theme='dark'] .btn-secondary:hover {
    background: var(--color-border);
  }
