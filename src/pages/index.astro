---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base>
  <section class="hero">
    <div class="hero-content">
      <h1 class="hero-title">{site.title}</h1>
      <p class="hero-subtitle">{site.tagline}</p>
      <p class="hero-desc">几许岚光，一襟晚照</p>
      <div class="hero-buttons">
        <a class="btn btn-primary" href="/docs">📘 开始阅读</a>
        <a class="btn btn-secondary" href="/now">💬 最近动态</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .hero {
    padding: 3rem 2rem;
    margin-top: 1rem;
  }

  .hero-content {
    max-width: 640px;
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
    color: var(--color-heading);
  }

  .hero-subtitle {
    font-family: 'Brush Script MT', 'Segoe Script', 'Lucida Handwriting',
      'Apple Chancery', cursive;
    font-size: 1.75rem;
    color: var(--color-primary);
    opacity: 0.9;
    margin-bottom: 0.5rem;
  }

  .hero-desc {
    color: var(--color-muted);
    font-size: 1.1rem;
    margin-bottom: 2.5rem;
  }

  .hero-buttons {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
    font-weight: 500;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.15s ease;
    text-decoration: none;
    border: 1px solid transparent;
  }

  .btn:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }

  .btn-primary {
    background: var(--color-primary);
    color: white;
    box-shadow: 0 2px 8px rgba(193, 95, 60, 0.25);
  }

  .btn-primary:hover {
    background: var(--color-primary-dark);
    box-shadow: 0 2px 8px rgba(193, 95, 60, 0.35);
  }

  .btn-secondary {
    background: var(--color-surface);
    color: var(--color-text);
    border-color: var(--color-border);
  }

  .btn-secondary:hover {
    background: var(--color-surface-muted);
  }

  :root[data-theme='dark'] .btn-primary {
    box-shadow: 0 2px 8px rgba(232, 150, 118, 0.2);
  }

  :root[data-theme='dark'] .btn-primary:hover {
    box-shadow: 0 2px 8px rgba(232, 150, 118, 0.3);
  }

  :root[data-theme='dark'] .btn-secondary {
    background: var(--color-surface);
  }

  :root[data-theme='dark'] .btn-secondary:hover {
    background: var(--color-surface-muted);
  }
</style>
