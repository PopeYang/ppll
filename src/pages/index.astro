---
import Base from '../layouts/Base.astro';
import { site, sections } from '../data/site';
import { getCollection } from 'astro:content';
import { getDocPath } from '../lib/routes';
import { fetchMastodon } from '../lib/mastodon';

// 获取最近的文档
const entries = await getCollection('docs');
const recentPosts = entries
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 6);

// 侧栏动态：构建期拉取 Mastodon，与 /now 页同源。
// 拉取失败时 toots 为空数组，侧栏优雅降级为一条提示。
const profile = await fetchMastodon();
const recentToots = profile.toots.slice(0, 6);

/** 侧栏空间窄，把嘟文 HTML 压成纯文本并截断 */
function toExcerpt(html: string, max = 60): string {
  const text = html
    .replace(/<[^>]+>/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  return text.length > max ? text.slice(0, max) + '…' : text;
}
---

<Base>
  <div class="layout-container">
    <main class="content-side">
      <header class="page-header">
        <p class="site-tagline with-author">
          {site.tagline}
          <span class="site-author">by ppy</span>
        </p>
      </header>

      <h2 class="section-title">{sections.docs.nav}</h2>

      <div class="post-list">
        {recentPosts.map((post) => (
          <article class="post-item">
            <a href={getDocPath(post)} class="post-link">
              <h3 class="post-title">{post.data.title}</h3>
              {post.data.description && (
                <p class="post-excerpt">{post.data.description}</p>
              )}
              <time class="post-date">
                {new Date(post.data.date).toLocaleDateString('zh-CN')}
              </time>
            </a>
          </article>
        ))}
      </div>

      <div class="more-link">
        <a href="/docs">全部文章 →</a>
      </div>
    </main>

    <aside class="timeline-side">
      <h2 class="section-title">{sections.now.nav}</h2>
      <div class="timeline-list">
        {recentToots.length === 0 ? (
          <p class="timeline-empty">暂时拉不到动态。</p>
        ) : (
          recentToots.map((toot) => (
            <a
              href={toot.url}
              class="timeline-item"
              target="_blank"
              rel="noopener noreferrer"
            >
              <time class="timeline-time" datetime={toot.pubDate.toISOString()}>
                {toot.pubDate.toLocaleDateString('zh-CN', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </time>
              <p class="timeline-content">{toExcerpt(toot.contentHtml)}</p>
            </a>
          ))
        )}
      </div>

      <div class="more-link">
        <a href="/now">更多动态 →</a>
      </div>
    </aside>
  </div>
</Base>

<style>
  .layout-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1.5rem 5rem;
    display: grid;
    grid-template-columns: 7fr 3fr;
    gap: 4rem;
  }

  .content-side {
    min-width: 0;
  }

  .page-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .post-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 2.5rem;
    margin-bottom: 2.5rem;
  }

  .post-item {
    padding-bottom: 1rem;
  }

  .post-link {
    color: inherit;
    text-decoration: none;
  }

  .post-link:hover .post-title {
    color: var(--color-primary-dark);
  }

  .post-title {
    font-size: 1.05rem;
    font-weight: 500;
    margin: 0 0 0.4rem;
    line-height: 1.45;
    color: var(--color-heading);
    transition: color 0.15s ease;
  }

  .post-excerpt {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-muted);
    margin: 0 0 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-date {
    font-size: 0.75rem;
    color: var(--color-muted);
    opacity: 0.7;
  }

  .timeline-side {
    padding-top: 1rem;
  }

  .section-title {
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    margin: 0 0 1.5rem;
  }

  .timeline-list {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    margin-bottom: 2rem;
  }

  .timeline-item {
    position: relative;
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .timeline-item:hover .timeline-content {
    color: var(--color-primary-dark);
  }

  :root[data-theme='dark'] .timeline-item:hover .timeline-content {
    color: var(--color-primary);
  }

  .timeline-empty {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin: 0;
    opacity: 0.8;
  }

  .timeline-time {
    display: block;
    font-size: 0.7rem;
    color: var(--color-muted);
    letter-spacing: 0.05em;
    margin-bottom: 0.4rem;
    opacity: 0.7;
  }

  .timeline-content {
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--color-text);
    margin: 0;
    transition: color 0.15s ease;
  }

  .more-link {
    margin-top: 0.5rem;
  }

  .more-link a {
    font-size: 0.85rem;
    color: var(--color-primary);
    text-decoration: none;
    opacity: 0.85;
    transition: opacity 0.15s ease;
  }

  .more-link a:hover {
    opacity: 1;
  }

  @media (max-width: 900px) {
    .layout-container {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding-top: 3rem;
    }

    .post-list {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .timeline-side {
      padding-top: 2rem;
      border-top: 1px solid var(--color-border);
    }
  }
</style>
