---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { getCollection } from 'astro:content';

// 获取最近的文档
const entries = await getCollection('docs');
const recentPosts = entries
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 8);

// 动态数据
const fakeToots = [
  {
    id: 1,
    date: new Date(),
    content: "今天把博客的主题终于定下来了 —— 「凭岚」，山野长风任几许。折腾了一下午的排版，看着还挺有那味儿的 🍃",
  },
  {
    id: 2,
    date: new Date(Date.now() - 86400000 * 2),
    content: "发现 Astro 的开发体验真的比之前用的都好，增量编译快到飞起。就是有时候样式改着改着文件结构就乱了…",
  },
  {
    id: 3,
    date: new Date(Date.now() - 86400000 * 5),
    content: "周末终于把 FreeCAD 的构建流程跑通了。文档写了一半，后面慢慢补。开源软件的编译真是一门玄学 🫠",
  },
  {
    id: 4,
    date: new Date(Date.now() - 86400000 * 7),
    content: "从 SVN 迁移到 Git，路径处理踩了不少坑。总结了几条最佳实践，后面整理出来发文库。",
  },
];
---

<Base>
  <div class="layout-container">
    <main class="content-side">
      <header class="page-header">
        <p class="site-tagline">
          {site.tagline}
          <span class="site-author">by ppy</span>
        </p>
      </header>

      <div class="post-list">
        {recentPosts.map((post) => (
          <article class="post-item">
            <a href={`/docs/${post.slug}/`} class="post-link">
              <h3 class="post-title">{post.data.title}</h3>
              {post.data.description && (
                <p class="post-excerpt">{post.data.description}</p>
              )}
              <time class="post-date">
                {new Date(post.data.date).toLocaleDateString('zh-CN')}
              </time>
            </a>
          </article>
        ))}
      </div>

      <div class="more-link">
        <a href="/docs">全部文章 →</a>
      </div>
    </main>

    <aside class="timeline-side">
      <h2 class="timeline-title">风过留痕</h2>
      <div class="timeline-list">
        {fakeToots.map((toot) => (
          <div class="timeline-item" key={toot.id}>
            <time class="timeline-time">
              {new Date(toot.date).toLocaleDateString('zh-CN', { 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric' 
              })}
            </time>
            <p class="timeline-content">{toot.content}</p>
          </div>
        ))}
      </div>

      <div class="more-link">
        <a href="/now">更多动态 →</a>
      </div>
    </aside>
  </div>
</Base>

<style>
  .layout-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1.5rem 5rem;
    display: grid;
    grid-template-columns: 7fr 3fr;
    gap: 4rem;
  }

  .content-side {
    min-width: 0;
  }

  .page-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .site-tagline {
    position: relative;
    font-family: Georgia, 'Noto Serif CJK SC', 'Songti SC', SimSun, serif;
    font-size: 2rem;
    color: var(--color-primary);
    opacity: 0.85;
    margin: 0;
    letter-spacing: 0.1em;
    line-height: 1.4;
    padding-right: 7rem;
    padding-bottom: 0.5rem;
  }

  .site-author {
    position: absolute;
    right: 0;
    bottom: 0;
    font-family: 'Brush Script MT', 'Segoe Script', 'Lucida Handwriting',
      'Apple Chancery', cursive;
    font-size: 1.25rem;
    color: var(--color-muted);
    letter-spacing: 0.05em;
    font-weight: 400;
    opacity: 0.8;
  }

  .post-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 2.5rem;
    margin-bottom: 2.5rem;
  }

  .post-item {
    padding-bottom: 1rem;
  }

  .post-link {
    color: inherit;
    text-decoration: none;
  }

  .post-link:hover .post-title {
    color: var(--color-primary-dark);
  }

  .post-title {
    font-size: 1.05rem;
    font-weight: 500;
    margin: 0 0 0.4rem;
    line-height: 1.45;
    color: var(--color-heading);
    transition: color 0.15s ease;
  }

  .post-excerpt {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-muted);
    margin: 0 0 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-date {
    font-size: 0.75rem;
    color: var(--color-muted);
    opacity: 0.7;
  }

  .timeline-side {
    padding-top: 1rem;
  }

  .timeline-title {
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    text-transform: uppercase;
    margin: 0 0 1.5rem;
  }

  .timeline-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .timeline-item {
    position: relative;
  }

  .timeline-time {
    display: block;
    font-size: 0.7rem;
    color: var(--color-muted);
    letter-spacing: 0.05em;
    margin-bottom: 0.4rem;
    opacity: 0.7;
  }

  .timeline-content {
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--color-text);
    margin: 0;
  }

  .more-link {
    margin-top: 0.5rem;
  }

  .more-link a {
    font-size: 0.85rem;
    color: var(--color-primary);
    text-decoration: none;
    opacity: 0.85;
    transition: opacity 0.15s ease;
  }

  .more-link a:hover {
    opacity: 1;
  }

  @media (max-width: 900px) {
    .layout-container {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding-top: 3rem;
    }

    .post-list {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .timeline-side {
      padding-top: 2rem;
      border-top: 1px solid var(--color-border);
    }

    .site-tagline {
      font-size: 1.5rem;
      padding-right: 5rem;
    }

    .site-author {
      font-size: 1rem;
    }
  }
</style>
