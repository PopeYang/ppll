---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import { getBlogPath } from '../lib/routes';
import { getAuthor } from '../data/authors';
import { readingTime } from '../lib/reading-time';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, pubDate, description, authors } = entry.data;
const author = authors[0] ? getAuthor(authors[0]) : undefined;
const minutes = readingTime(entry.body);
const dateStr = pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const canonicalPath = getBlogPath(entry);
---

<Base title={title} description={description} canonicalPath={canonicalPath}>
  <article class="post">
    <header class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        {author && (
          <span class="meta-author">
            <img src={author.image_url} alt={author.name} class="author-avatar" width="24" height="24" />
            <a href={author.url} target="_blank" rel="noopener noreferrer">{author.name}</a>
          </span>
        )}
        <time datetime={pubDate.toISOString()}>{dateStr}</time>
        <span class="meta-sep">·</span>
        <span>{minutes} 分钟阅读</span>
      </div>
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="post-footer">
      <a href="/blog">← 返回博客列表</a>
    </footer>
  </article>
</Base>

<style>
  .post {
    max-width: 760px;
    margin: 0 auto;
  }

  .post-header {
    margin-bottom: 2rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .post-header h1 {
    margin-bottom: 0.8rem;
  }

  .post-meta {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .meta-author {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .author-avatar {
    border-radius: 50%;
    width: 24px;
    height: 24px;
  }

  .meta-sep {
    opacity: 0.6;
  }

  .post-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
  }
</style>
