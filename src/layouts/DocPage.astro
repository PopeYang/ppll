---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import { getDocPath } from '../lib/routes';
import { tagUrl } from '../lib/tags';
import { sections } from '../data/site';

interface Props {
  entry: CollectionEntry<'docs'>;
}

const { entry } = Astro.props;
const { title, description, date, tags } = entry.data;
const canonicalPath = getDocPath(entry);
const dateStr = date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={title} description={description} canonicalPath={canonicalPath}>
  <article class="doc">
    <header class="doc-header">
      <div class="doc-breadcrumb">
        <a href="/docs/">{sections.docs.ui}</a>
      </div>
      <h1>{title}</h1>
      {description && <p class="doc-description">{description}</p>}
      <div class="doc-meta">
        <time datetime={date.toISOString()}>{dateStr}</time>
        {tags.length > 0 && (
          <span class="doc-tags">
            {tags.map((t: string) => (
              <a href={tagUrl(t)} class="tag">#{t}</a>
            ))}
          </span>
        )}
      </div>
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="doc-footer">
      <a href="/docs/">← 返回{sections.docs.ui}</a>
    </footer>
  </article>
</Base>

<style>
  .doc {
    max-width: 760px;
    margin: 0 auto;
  }

  .doc-breadcrumb {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-bottom: 0.6rem;
  }

  .doc-breadcrumb a {
    color: var(--color-muted);
  }

  .doc-header {
    margin-bottom: 2rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .doc-header h1 {
    margin-bottom: 0.5rem;
  }

  .doc-description {
    color: var(--color-muted);
    margin: 0 0 1rem;
    font-size: 1.05rem;
  }

  .doc-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.8rem;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .doc-tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    display: inline-block;
    padding: 0.1rem 0.6rem;
    background: var(--color-surface-muted);
    border-radius: 12px;
    font-size: 0.82rem;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
  }

  .tag:hover {
    color: var(--color-primary-dark);
    border-color: var(--color-primary);
    background: rgba(217, 119, 87, 0.08);
    text-decoration: none;
  }

  :root[data-theme='dark'] .tag:hover {
    color: var(--color-primary);
  }

  .doc-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
  }
</style>
