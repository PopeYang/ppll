---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <p class="copyright">© {year} {site.author}. 破破烂烂，缝缝补补。</p>
    <nav class="footer-links" aria-label="页脚">
      <a href="/blog">博客</a>
      <a href="/docs">文档</a>
      <a href="/rss.xml" aria-label="RSS 订阅">RSS</a>
      <a href={site.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    margin-top: 4rem;
    padding: 1.8rem 0;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .copyright {
    margin: 0;
  }

  .footer-links {
    display: inline-flex;
    gap: 1.2rem;
  }

  .footer-links a {
    color: var(--color-muted);
  }

  .footer-links a:hover {
    color: var(--color-primary-dark);
  }
</style>
