---
import ThemeToggle from './ThemeToggle.astro';
import { site, sections } from '../data/site';

const { pathname } = Astro.url;
// 高亮当前激活的导航项（去除尾部斜杠后比较）
const current = pathname.replace(/\/+$/, '') || '/';
function isActive(href: string): boolean {
  if (href === '/') return current === '/';
  return current === href || current.startsWith(href + '/');
}
---

<header class="site-header">
  <div class="navbar-inner">
    <a href="/" class="brand">
      <img src="/img/logo.svg" alt="ppy Logo" class="brand-logo" width="32" height="32" />
      <span class="brand-title">{site.title}</span>
    </a>

    <nav class="nav-items" aria-label="主导航">
      <a href="/docs" class={isActive('/docs') ? 'nav-link active' : 'nav-link'}
        ><span class="label-long">{sections.docs.nav}</span><span class="label-short"
          >文库</span
        ></a
      >
      <a href="/now" class={isActive('/now') ? 'nav-link active' : 'nav-link'}
        ><span class="label-long">{sections.now.nav}</span><span class="label-short"
          >动态</span
        ></a
      >
      <a
        href={site.githubUrl}
        class="nav-link external"
        target="_blank"
        rel="noopener noreferrer">GitHub</a
      >
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    pointer-events: none;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    padding: 0;
  }

  .site-header.scrolled {
    padding: 1rem 1rem 0;
  }

  .site-header.hidden {
    transform: translateY(-120%);
  }

  .navbar-inner {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 100%;
    margin: 0 auto;
    padding: 0.75rem 2rem;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    background: transparent;
    border-radius: 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .site-header.scrolled .navbar-inner {
    max-width: 900px;
    padding: 0.5rem 0.75rem;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.4),
      rgba(255, 255, 255, 0.6)
    );
    border-radius: 9999px;
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.06),
      0 0 0 1px rgba(0, 0, 0, 0.04);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom-color: transparent;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-heading);
    font-weight: 400;
    font-size: 1.15rem;
    letter-spacing: 0.1em;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    transition: background-color 0.15s ease;
  }

  .brand:hover {
    text-decoration: none;
    background: rgba(0, 0, 0, 0.04);
  }

  .brand-logo {
    border-radius: 6px;
  }

  .nav-items {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    color: var(--color-text);
    font-size: 0.9rem;
    padding: 0.375rem 0.875rem;
    border-radius: 9999px;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--color-primary-dark);
    text-decoration: none;
    background: rgba(193, 95, 60, 0.06);
  }

  .nav-link.active {
    color: var(--color-primary-dark);
    background: rgba(193, 95, 60, 0.08);
    font-weight: 500;
  }

  /* 窄屏回落到短名：两个七字长名 + GitHub + 主题开关会撑破胶囊 */
  .label-short {
    display: none;
  }

  @media (max-width: 768px) {
    .label-long {
      display: none;
    }

    .label-short {
      display: inline;
    }
  }

  :root[data-theme='dark'] .navbar-inner {
    border-bottom-color: rgba(255, 255, 255, 0.06);
  }

  :root[data-theme='dark'] .site-header.scrolled .navbar-inner {
    background: linear-gradient(
      135deg,
      rgba(35, 34, 32, 0.4),
      rgba(35, 34, 32, 0.6)
    );
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.15),
      0 0 0 1px rgba(255, 255, 255, 0.06);
    border-bottom-color: transparent;
  }

  :root[data-theme='dark'] .brand:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  :root[data-theme='dark'] .nav-link:hover,
  :root[data-theme='dark'] .nav-link.active {
    color: var(--color-primary);
    background: rgba(232, 150, 118, 0.12);
  }
</style>

<script is:inline>
  (function() {
    let lastScrollY = window.scrollY;
    const header = document.querySelector('.site-header');
    const scrollThreshold = 20;

    function updateHeader() {
      const currentScrollY = window.scrollY;

      if (currentScrollY > scrollThreshold) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }

      lastScrollY = currentScrollY;
    }

    window.addEventListener('scroll', updateHeader, { passive: true });
    
    // Initial check
    updateHeader();
  })();
</script>
