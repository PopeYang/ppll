---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';

const { pathname } = Astro.url;
// 高亮当前激活的导航项（去除尾部斜杠后比较）
const current = pathname.replace(/\/+$/, '') || '/';
function isActive(href: string): boolean {
  if (href === '/') return current === '/';
  return current === href || current.startsWith(href + '/');
}
---

<header class="navbar">
  <div class="container navbar-inner">
    <a href="/" class="brand">
      <img src="/img/logo.svg" alt="ppy Logo" class="brand-logo" width="28" height="28" />
      <span class="brand-title">{site.title}</span>
    </a>

    <nav class="nav-items" aria-label="主导航">
      <a href="/docs" class={isActive('/docs') ? 'nav-link active' : 'nav-link'}>破破文档</a>
      <a href="/now" class={isActive('/now') ? 'nav-link active' : 'nav-link'}>动态</a>
      <a
        href={site.githubUrl}
        class="nav-link external"
        target="_blank"
        rel="noopener noreferrer">GitHub</a
      >
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    transition: background-color 0.15s ease;
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-heading);
    font-weight: 600;
    font-size: 1.1rem;
    transition: opacity 0.2s var(--ease);
  }

  .brand:hover {
    text-decoration: none;
    opacity: 0.85;
  }

  .brand-logo {
    border-radius: 6px;
  }

  .nav-items {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-link {
    color: var(--color-text);
    font-size: 0.95rem;
    padding: 0.3rem 0;
    border-bottom: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--color-primary-dark);
    text-decoration: none;
  }

  .nav-link.active {
    color: var(--color-primary-dark);
    border-bottom-color: var(--color-primary);
  }

  :root[data-theme='dark'] .navbar {
    background-color: var(--color-bg);
  }

  :root[data-theme='dark'] .nav-link:hover,
  :root[data-theme='dark'] .nav-link.active {
    color: var(--color-primary);
  }
